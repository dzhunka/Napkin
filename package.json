{
  "name": "mcp-app-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-codex.mjs",
    "dev:server": "concurrently --kill-others --names widget,next \"vite build --watch\" \"next dev\"",
    "build:widget": "vite build",
    "build": "pnpm build:widget && next build",
    "start": "next start",
    "lint": "eslint",
    "test:client": "node scripts/test-client.mjs",
    "capture-thread": "node scripts/capture-seed-thread.mjs",
    "set-endpoint": "node scripts/set-endpoint.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "mcp-handler": "^2.2.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
